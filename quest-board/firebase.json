{
  "hosting": {
    "public": "dist-web",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/api/sample", "function": { "functionId": "sample", "region": "us-central1" } }
    ],
    "headers": [
      { "source": "**/*.@(js|webp|png|json)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/@(index.html|sw.js|manifest.webmanifest|config.js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "default", "runtime": "nodejs22", "ignore": ["node_modules", "test.js", ".git"] }
  ],
  "firestore": { "rules": "firestore.rules" }
}
