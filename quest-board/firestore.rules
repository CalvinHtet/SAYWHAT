rules_version = '2';
// Quest Board's web build (docs/WEBAPP.md): the same rules the Claude version declares, on Firestore.
// Every doc holds {j: "<json>", t: <ms>} (web/web.js), so these only look at paths and who is signed in.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Cal's uid goes here (and in web/config.js) after his first sign-in on the web build
    function owner() { return signedIn() && request.auth.uid in ["RwoCZ8hu7GNFof5SjKzZFtlqqRH3"]; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }

    // what others see of each player, their town-hall posts and reactions, and their visit notes: everyone signed in reads,
    // only that player writes
    match /worlds/{uid} { allow read: if signedIn(); allow write: if mine(uid); }
    match /board/{uid}  { allow read: if signedIn(); allow write: if mine(uid); }
    match /pings/{uid}  { allow read: if signedIn(); allow write: if mine(uid); }

    // each player's save, backup and save-choice record: that player only
    match /data/users/{uid}/{doc} { allow read, write: if mine(uid); }

    // the Town Hall (app/src/29t_chat.js, 29u_style.js): chat/<id> holds that player's last messages in each room, chatnow/<id>
    // the room they have open, likes/<id> whose looks they like this week. Everyone signed in reads; only that player writes. The
    // owner may also write or delete any chat or chatnow doc and delete any likes doc (moderation). Each doc must be the {j, t}
    // the web wrapper writes, with j capped, so nobody can fill the database.
    function small(n) {
      return request.resource.data.keys().hasOnly(["j", "t"]) && request.resource.data.j is string
        && request.resource.data.j.size() < n && request.resource.data.t is number;
    }
    match /chat/{uid}    { allow read: if signedIn(); allow create, update: if (mine(uid) || owner()) && small(20000); allow delete: if mine(uid) || owner(); }
    match /chatnow/{uid} { allow read: if signedIn(); allow create, update: if (mine(uid) || owner()) && small(2000); allow delete: if mine(uid) || owner(); }
    match /likes/{uid}   { allow read: if signedIn(); allow create, update: if mine(uid) && small(8000); allow delete: if mine(uid) || owner(); }

    // kind words for coins (app/src/29v_kudos.js): kudos/<id> holds the notes that player wrote the owner, read by them and the
    // owner; kudosok/<id> holds the owner's answer to each. Only the owner writes answers, so only the owner can approve a note
    // (and pay its coins). Everyone signed in reads the answers: the Town Hall pins the approved notes.
    match /kudos/{uid}   { allow read: if mine(uid) || owner(); allow create, update: if mine(uid) && small(12000); allow delete: if mine(uid) || owner(); }
    match /kudosok/{uid} { allow read: if signedIn(); allow create, update: if owner() && small(30000); allow delete: if owner(); }

    // challenges with a coin pot (app/src/29w_duel.js): duel/<id> holds the challenges that player sent, their answers to
    // challenges sent to them and their own scores. Everyone signed in reads (both sides need the other's doc); only that player
    // writes.
    match /duel/{uid} { allow read: if signedIn(); allow create, update: if mine(uid) && small(30000); allow delete: if mine(uid) || owner(); }

    // the owner's inbox and the frame and speed logs the owner reads to debug phones
    match /inbox/{doc} { allow read, write: if owner(); }
    match /diag/{doc}  { allow read: if owner(); allow write: if signedIn(); }

    // the Claude version's old single save, looked up once by the owner's first boot; nothing is ever there on the web
    match /player/{doc} { allow read: if owner(); allow write: if false; }

    // the AI function's daily counts: the function only (it runs as admin and skips these rules)
    match /limits/{doc} { allow read, write: if false; }
  }
}
